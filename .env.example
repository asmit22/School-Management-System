# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings → API.
#
# Vite only exposes env vars to client code when they're prefixed with
# VITE_ — that prefix is required, not optional.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
